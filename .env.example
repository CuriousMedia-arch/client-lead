# ── Database (Supabase Postgres) ────────────────────────────────────────────
# Supabase → Project → Connect → "Connection pooling" → URI.
# Use the POOLER string (port 6543), not the direct 5432 one.
DATABASE_URL=

# ── Required ────────────────────────────────────────────────────────────────
# NewsAPI.ai (Event Registry) key — same one the old scraper used.
NEWSAPI_AI_KEY=

# ── Optional but recommended ────────────────────────────────────────────────
# Gemini writes the summary, the "why it matters" line and the score.
# Without it the app falls back to keyword classification and still works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── "Run now" button on the deployed app ────────────────────────────────────
# A scan takes minutes; a Vercel function dies at 60s. So on Vercel the button
# asks GitHub Actions to run it. Leave these blank locally and it runs in-process.
# Token: GitHub → Settings → Developer settings → fine-grained PAT,
# repo access = your repo, permission = Actions (read and write).
GITHUB_REPO=
GITHUB_TOKEN=
GITHUB_BRANCH=main

# ── Server ──────────────────────────────────────────────────────────────────
PORT=4000

# ── Collection cycle (local only — the deploy uses GitHub Actions) ──────────
CRON_SCHEDULE=0 2 */3 * *
TZ_NAME=Asia/Kolkata
# DISABLE_SCHEDULER=true
RESULTS_PER_QUERY=50
REQUEST_DELAY_MS=1200

# Set to true when serving over HTTPS. Vercel is always HTTPS, so: true.
SECURE_COOKIES=true

# ── Fresh Leads (discovery sweep) ───────────────────────────────────────────
# Finds companies that aren't on your watchlist. Needs GEMINI_API_KEY.
# DISCOVERY_ENABLED=false     # turn the sweep off entirely
DISCOVERY_PER_SITE=8
DISCOVERY_WINDOW_HOURS=72

# ── Auto-scan on sign-in ────────────────────────────────────────────────────
# A cycle starts when someone signs in, but only if the last one is older than
# this. Stops ten people signing in from triggering ten scans.
AUTOSCAN_HOURS=12
# AUTOSCAN=false            # turn sign-in scanning off entirely

# Gemini model. The portal calls the native endpoint directly, so both the old
# AIza keys and the new AQ. Auth keys work. Change this if your key doesn't
# have access to the default model.
GEMINI_MODEL=gemini-2.0-flash

# NewsAPI.ai counts every WORD in a query against your plan's limit, not every
# phrase. Set this to your plan's allowance — the sweep splits itself into that
# many queries automatically.
DISCOVERY_TERM_BUDGET=100

# ── Claim windows ───────────────────────────────────────────────────────────
# Claim from Fresh Leads and you have this many days to close it, or it goes
# to the Newspaper for anyone to pick up. Claims from All Leads get longer,
# and simply return to All Leads.
CLAIM_DAYS_FRESH=10
CLAIM_DAYS_ALL=30

# How recent a signal must be for a company to appear in Fresh Leads.
FRESH_WINDOW_DAYS=14

# ── Google: Meet, Calendar and sending mail ─────────────────────────────────
# Optional. Without these the portal still works — meetings save without a
# Meet link and notes are typed by hand. Setup: GOOGLE-SETUP.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.com/api/google/callback

# Encrypts Google refresh tokens before they are stored. Any long random
# string: openssl rand -hex 32
TOKEN_SECRET=

# ── Microsoft 365: Teams meetings, transcripts, Outlook mail ────────────────
# The recommended path — Curious Media already pays for these licences.
# Setup: MICROSOFT-SETUP.md
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_REDIRECT_URI=https://your-domain.com/api/microsoft/callback

# ── Fathom: meeting transcripts, any platform, no admin needed ─────────────
# The bot joins the call and records it, so this works on a free Google
# account. We take only the transcript — the notes are written by this app.
# Setup: FATHOM-SETUP.md
FATHOM_API_KEY=
FATHOM_WEBHOOK_SECRET=

# ── Background sweeps ───────────────────────────────────────────────────────
# Lets GitHub Actions call /api/cron/sweep so overdue leads are released even
# when nobody is logged in. Without it that endpoint refuses every request
# rather than running unauthenticated.
CRON_SECRET=
